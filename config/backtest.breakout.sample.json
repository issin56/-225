{
  "data": {
    "file_path": "tests/fixtures/sample_ohlcv_breakout.csv"
  },
  "strategy": {
    "name": "breakout",
    "allow_reversal": true,
    "parameters": {
      "lookback_period": 4
    }
  },
  "risk": {
    "stop_loss": 0.0012,
